          "request": {
            "name": "Issue or refresh an access token",
            "description": {
              "content": "Obtain an access token using either the `client_credentials` grant (initial issuance) or the `refresh_token` grant (refresh an expired token). Tokens expire after one hour.",
              "type": "text/plain"
            },
            "url": {
